[Unit]
Description=ANNAgram clone API
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/insta-clone/backend
Environment=APP_ENV=server
EnvironmentFile=-/home/ec2-user/insta-clone/backend/.env.server
ExecStart=/home/ec2-user/insta-clone/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
