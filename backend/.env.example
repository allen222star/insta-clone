# APP_ENV=local  → backend/instagram.db
# APP_ENV=server → backend/instagram.server.db
# 비우면 OS/호스트로 추정한다. DATABASE_URL이 있으면 그 값을 우선한다.
APP_ENV=local
# DATABASE_URL=sqlite:///C:/data/instagram.db
SECRET_KEY=dev-instagram-clone-secret-change-me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
